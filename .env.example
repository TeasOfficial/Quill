# ── OneBot 连接（必填） ────────────────────────────
ONEBOT_BASE_URL=http://localhost:3007
ONEBOT_WS_URL=http://localhost:12006
ONEBOT_TOKEN=your_token_here

# WS 模式: forward（正向连接）/ reverse（反向服务端）
ONEBOT_WS_MODE=forward

# ── 文件 I/O（高危） ─────────────────────────────
# 解除 bot.file 读写路径限制，可访问任意路径
# ONEBOT_FILE_UNSAFE=true

# ── 内置 HTTP（高危） ────────────────────────────
# 关闭 TLS 证书校验，仅用于自签证书环境
# ONEBOT_HTTP_INSECURE=true

# ── 数据库（可选） ───────────────────────────────
# sqlite（默认写入 data/bot.db）或 mysql
# ONEBOT_SQL_DRIVER=sqlite
# ONEBOT_SQL_DSN=user:pass@tcp(127.0.0.1:3306)/quill?parseTime=true

# ── mapdl 插件（可选） ───────────────────────────
# CS:S 服务器的 cstrike/maps 目录；不填则 /mapdl 会提示未配置
# MAPDL_MAPS_DIR=D:\servers\css\cstrike\maps
# MAPDL_TEMP_DIR=D:\servers\css\mapdl_temp
# MAPDL_FASTDL_BASE=https://main.fastdl.me/maps/
